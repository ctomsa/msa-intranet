            {{-- bookings overlay --}}
            @foreach($bookings as $b)
                @php
                    $start = Carbon::parse($b->start_at);
                    $end   = Carbon::parse($b->end_at);

                    // Показываем только Пн–Пт текущей недели
                    $dayIndex = $days->search(fn($d) => $d->isSameDay($start));
                    if ($dayIndex === false) continue;

                    // clamp на рабочее время (08–20), чтобы блоки не вылазили
                    $startMin = max($dayStart, $start->hour * 60 + $start->minute);
                    $endMin   = min($dayEnd, $end->hour * 60 + $end->minute);

                    $duration = max($step, $endMin - $startMin);
                    $rowStart = 2 + intval(($startMin - $dayStart) / $step); // +2 row header
                    $rowSpan  = max(1, intval(ceil($duration / $step)));

                    $col = 2 + $dayIndex; // col1 time, then 5 day cols
                @endphp

                <div
                    style="
                        grid-column: {{ $col }};
                        grid-row: {{ $rowStart }} / span {{ $rowSpan }};
                        z-index: 5;
                        margin: 2px 6px;
                        background: #6A5BFF;
                    "
                    class="booking-block"
                    title="{{ $start->format('H:i') }}–{{ $end->format('H:i') }} • {{ $b->title ?? '' }}"
                >
